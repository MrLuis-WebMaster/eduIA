# Backend base URL (no trailing slash).
# Web / iOS simulator: http://localhost:3001
# Android emulator:    http://10.0.2.2:3001  (maps to host localhost)
# Physical device:     http://192.168.x.x:3001 (PC LAN IP)
EXPO_PUBLIC_API_URL=http://localhost:3001

# Tutor engine on the device:
#   fake   = FakeTutorEngine (no network / no backend)
#   remote = HttpTutorEngine → POST /api/v1/tutor/messages
EXPO_PUBLIC_TUTOR_MODE=fake
