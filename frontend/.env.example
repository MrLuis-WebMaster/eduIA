# Backend base URL (no trailing slash).
# Use localhost for simulators/web; use your PC LAN IP for a physical device, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Tutor engine on the device:
#   fake   = FakeTutorEngine (no network / no backend)
#   remote = HttpTutorEngine → POST /api/v1/tutor/messages
EXPO_PUBLIC_TUTOR_MODE=fake
