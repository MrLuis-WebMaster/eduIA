{
  "name": "muyu-eduia",
  "version": "0.1.0",
  "private": true,
  "description": "EduIA — AI tutoring companion (Muyu take-home)",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "start": "pnpm --filter frontend start",
    "start:dev-client": "pnpm --filter frontend start:dev-client",
    "start:tunnel": "pnpm --filter frontend start:tunnel",
    "android": "pnpm --filter frontend android",
    "ios": "pnpm --filter frontend ios",
    "web": "pnpm --filter frontend web",
    "expo": "pnpm --filter frontend exec expo",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm --filter backend build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
