PORT=3001
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info

# AI provider (only used when frontend EXPO_PUBLIC_TUTOR_MODE=remote):
#   fake   = deterministic responses, no API key
#   openai = real OpenAI (requires OPENAI_API_KEY)
AI_PROVIDER=fake

# Required only when AI_PROVIDER=openai — never commit a real key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=20000

# Tutor route rate limit
TUTOR_RATE_LIMIT_WINDOW_MS=60000
TUTOR_RATE_LIMIT_MAX=30
